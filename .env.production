# Nexify Production Environment
# Copy to .env on the VPS and fill in real values before starting the server.

# ─── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database (PostgreSQL) ─────────────────────────
# Format: postgresql://user:password@host:5432/nexify
DATABASE_URL=postgresql://nexify:<PASSWORD>@localhost:5432/nexify
DATABASE_PROVIDER=postgresql

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=<CHANGE_ME_STRONG_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<CHANGE_ME_REFRESH_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

# ─── Platform Fees ─────────────────────────────────
PLATFORM_FEE_RATE=0.10
LAB_PLATFORM_FEE_RATE=0.15
DEFAULT_AFFILIATE_RATE=0.30

# ─── Security ──────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ─── CORS ──────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=https://gilded-chebakia-092cb1.netlify.app,http://localhost:5173

# ─── Frontend ──────────────────────────────────────
FRONTEND_URL=https://gilded-chebakia-092cb1.netlify.app

# ─── OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://nexify.app/api/v1/auth/google/callback

APPLE_CLIENT_ID=<YOUR_APPLE_CLIENT_ID>
APPLE_TEAM_ID=<YOUR_APPLE_TEAM_ID>
APPLE_KEY_ID=<YOUR_APPLE_KEY_ID>
APPLE_PRIVATE_KEY=<YOUR_APPLE_PRIVATE_KEY>

# ─── Payment ───────────────────────────────────────
PAYMENT_GATEWAY_SECRET=<YOUR_PAYMENT_GATEWAY_SECRET>

# ─── Nexa AI ───────────────────────────────────────
NEXA_LLM_PROVIDER=local
NEXA_API_KEY=
