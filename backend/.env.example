# Nexify Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=nexify-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Platform Economics
PLATFORM_FEE_RATE=0.10
LAB_PLATFORM_FEE_RATE=0.15
DEFAULT_AFFILIATE_RATE=0.30

# Nexa LLM (optional — uses local ollama or remote API)
NEXA_LLM_PROVIDER=local
NEXA_LLM_API_KEY=

# Payment Gateway (simulated in development)
PAYMENT_GATEWAY_SECRET=dev-gateway-secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Apple Sign in with Apple
# Configure at: https://developer.apple.com/app-store-connect/app-credentials
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
